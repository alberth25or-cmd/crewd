# Configuración de la aplicación web. Copia a .env.local y rellena.
#
# TODO ES OPCIONAL. Si faltan estas variables la aplicación funciona igual y
# la sección de financiamiento vuelve al estado "próximamente". Eso permite
# desplegar en Vercel antes de tener contratos, y evita que un error de
# configuración tumbe páginas que no tienen nada que ver con la cadena.
#
# Los valores salen de la salida de `npm run deploy:sepolia` en contracts/.

# 421614 = Arbitrum Sepolia · 31337 = red local de Hardhat
NEXT_PUBLIC_CHAIN_ID=421614

# Contrato de tesorería
NEXT_PUBLIC_CREWD_FUNDING_ADDRESS=

# Stablecoin de recaudación (MockUSDC en testnet)
NEXT_PUBLIC_STABLECOIN_ADDRESS=

# Bloque en el que se desplegó el contrato. Sin esto, leer los eventos
# obligaría a escanear la cadena desde el bloque 0 y ningún RPC público
# lo permite.
NEXT_PUBLIC_DEPLOY_BLOCK=

# RPC para las lecturas del servidor. Si se deja vacío se usa el público de
# Arbitrum, que sirve para probar pero limita las peticiones.
NEXT_PUBLIC_RPC_URL=
