# Copia este archivo a .env y rellénalo. .env está en .gitignore.
# NUNCA subas una clave privada al repositorio.

# RPC de Arbitrum Sepolia. El público funciona para pruebas; para algo serio
# usa Alchemy, Infura o QuickNode, que no te limitan tan agresivamente.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Clave privada de la cuenta que despliega, sin el prefijo 0x.
# Usa una cuenta desechable que solo tenga ETH de testnet.
DEPLOYER_PRIVATE_KEY=

# Para verificar el código fuente en Arbiscan. Opcional pero recomendado:
# sin verificar, nadie puede leer el contrato que está confiando.
ARBISCAN_API_KEY=
